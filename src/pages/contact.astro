---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const channels = [
  { label: 'LinkedIn', note: 'Connect', href: site.links.linkedin },
  { label: 'GitHub', note: '@Thapz123', href: site.links.github },
  { label: 'Résumé', note: 'PDF', href: site.resume },
];
---

<Base title="Contact" description={`Get in touch with ${site.name}.`}>
  <section class="mx-auto max-w-6xl px-4 pt-36 pb-28 sm:px-6 sm:pt-44">
    <p class="eyebrow text-moss" data-reveal>Contact</p>
    <h1 class="display mt-5 text-[clamp(4.5rem,14vw,10rem)]">
      <span class="block" data-split>Let’s</span>
      <span class="block italic text-umber" data-split>talk.</span>
    </h1>
    <p class="mt-8 max-w-xl text-lg leading-relaxed text-muted" data-reveal>
      Whether it’s a role, a system you’re untangling or a record recommendation, say hello.
    </p>

    <ul class="mt-20 border-b border-line">
      {channels.map((c) => (
        <li class="border-t border-line" data-reveal>
          <a
            href={c.href}
            target="_blank"
            rel="noopener"
            class="group relative flex items-center justify-between gap-6 overflow-hidden px-1 py-8 sm:py-10"
          >
            <span class="absolute inset-0 origin-bottom scale-y-0 bg-accent transition-transform duration-500 ease-[cubic-bezier(0.7,0,0.3,1)] group-hover:scale-y-100 group-focus-visible:scale-y-100" aria-hidden="true"></span>
            <span class="relative flex flex-wrap items-baseline gap-x-6 gap-y-2 transition-[color,translate] duration-500 group-hover:translate-x-4 group-hover:text-accent-ink">
              <span class="display text-5xl sm:text-7xl">{c.label}</span>
              <span class="eyebrow transition-colors duration-500 group-hover:text-accent-ink">{c.note}</span>
            </span>
            <span class="relative grid size-14 shrink-0 place-items-center rounded-full border border-line transition-all duration-500 group-hover:rotate-45 group-hover:border-accent-ink group-hover:text-accent-ink sm:size-16" data-magnetic>
              <Icon name="arrow" class="size-5" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
