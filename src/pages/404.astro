---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="mx-auto flex min-h-[80svh] max-w-6xl flex-col justify-center px-4 pt-16 sm:px-6">
    <p class="eyebrow text-moss" data-reveal>404 / Off the map</p>
    <h1 class="display mt-5 text-7xl sm:text-9xl" data-split>Nothing grows here.</h1>
    <a href="/" class="mt-10 w-fit rounded-full bg-fg px-5 py-3 font-mono text-[11px] tracking-[0.16em] text-bg uppercase transition-colors hover:bg-accent hover:text-accent-ink" data-reveal data-magnetic>
      Back home
    </a>
  </section>
</Base>
