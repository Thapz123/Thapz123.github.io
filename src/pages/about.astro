---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/portrait.png';
import { about, offClock, skills, spokenLanguages, site } from '../data/site';
---

<Base title="About" description={`About ${site.name}: engineer, musician and semi-frequent reader.`}>
  <section class="mx-auto max-w-6xl px-4 pt-36 pb-20 sm:px-6 sm:pt-44">
    <p class="eyebrow text-moss" data-reveal>About / Off the clock</p>
    <h1 class="display mt-5 max-w-4xl text-6xl sm:text-8xl" data-split>
      Engineer, musician &amp; semi-frequent reader.
    </h1>

    <div class="mt-16 grid gap-12 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-16">
      <figure class="group relative overflow-hidden rounded-2xl bg-raised" data-clip-reveal>
        <Image
          src={portrait}
          alt={`Portrait of ${site.name}`}
          widths={[400, 616]}
          sizes="(min-width: 768px) 40vw, 100vw"
          class="aspect-[4/5] w-full scale-110 object-cover"
          data-parallax
        />
        <div class="absolute inset-0 bg-moss opacity-55 mix-blend-multiply transition-opacity duration-700 group-hover:opacity-0" aria-hidden="true"></div>
        <figcaption class="eyebrow absolute bottom-4 left-4 rounded-full bg-bg/80 px-3 py-1.5 text-fg backdrop-blur">
          {site.origin} → {site.location}
        </figcaption>
      </figure>

      <div class="flex flex-col justify-between gap-12">
        <p class="text-2xl leading-snug sm:text-3xl" data-scrub-words>{about}</p>

        <dl class="grid grid-cols-2 gap-6 border-t border-line pt-6 text-sm">
          <div>
            <dt class="eyebrow">Based in</dt>
            <dd class="mt-2">{site.location}</dd>
          </div>
          <div>
            <dt class="eyebrow">From</dt>
            <dd class="mt-2">{site.origin}, South Africa</dd>
          </div>
          <div>
            <dt class="eyebrow">Studied</dt>
            <dd class="mt-2">CS (AI) at Stanford</dd>
          </div>
          <div>
            <dt class="eyebrow">Speaks</dt>
            <dd class="mt-2">{spokenLanguages.join(', ')}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="overflow-hidden border-y border-line py-6" aria-label="Skills">
    <div class="flex w-max" data-marquee>
      {[0, 1].map((copy) => (
        <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
          {skills.map((s) => (
            <li class="display flex items-center px-6 text-4xl whitespace-nowrap sm:text-5xl">
              {s}
              <span class="ml-12 inline-block size-2 rounded-full bg-accent" aria-hidden="true" />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-28 sm:px-6">
    <p class="eyebrow text-moss" data-reveal>When I’m not shipping</p>
    <ul class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
      {offClock.map((item, i) => (
        <li class="group relative bg-bg p-8 transition-colors duration-500 hover:bg-raised sm:p-10" data-reveal>
          <div class="flex items-start justify-between">
            <span class="font-mono text-xs text-muted">0{i + 1}</span>
            <span class="eq flex h-6 items-end gap-[3px] text-umber" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </span>
          </div>
          <h2 class="display mt-10 text-4xl">{item.title}</h2>
          <p class="mt-3 max-w-sm text-muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
