---
import Icon from './Icon.astro';
import type { projects } from '../data/site';

interface Props {
  project: (typeof projects)[number];
}
const { project: p } = Astro.props;
---

<article id={p.slug} class="scroll-mt-24 rounded-3xl border border-line bg-raised/40 p-6 sm:p-10">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
    <div>
      <p class="eyebrow" data-reveal>{p.year} <span class="text-moss">·</span> {p.kind}</p>
      <h3 class="display mt-3 text-4xl sm:text-5xl" data-reveal>{p.title}</h3>
      <p class="mt-4 max-w-xl text-lg leading-snug text-umber sm:text-xl" data-reveal>{p.tagline}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3" data-reveal>
        {p.links.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener"
            data-magnetic
            class="inline-flex items-center gap-2 rounded-full bg-fg px-5 py-3 font-mono text-[11px] tracking-[0.16em] text-bg uppercase transition-colors hover:bg-accent hover:text-accent-ink"
          >
            {l.label} <Icon name="arrow" class="size-3.5" />
          </a>
        ))}
      </div>

      {p.description.map((para, i) => (
        <p class:list={[i === 0 ? 'mt-10' : 'mt-6', 'max-w-2xl leading-relaxed text-muted']} data-reveal>{para}</p>
      ))}

      <ul class="mt-10 max-w-2xl space-y-3">
        {p.highlights.map((h) => (
          <li class="flex gap-3 leading-relaxed" data-reveal>
            <span class="mt-[0.7em] h-px w-4 shrink-0 bg-moss" aria-hidden="true" />
            <span>{h}</span>
          </li>
        ))}
      </ul>


    </div>

    <!-- A real card from the app, recreated in HTML: hover (or tap) to flip. -->
    <div class="mx-auto w-full max-w-sm lg:sticky lg:top-28 lg:max-w-none lg:self-start" data-reveal>
      <button
        type="button"
        class="flip group block w-full text-left [perspective:1400px]"
        aria-label="Example flashcard: tap to flip"
        data-flip
      >
        <div class="flip-inner relative aspect-[4/5] w-full transition-transform duration-700 [transform-style:preserve-3d]">
          <div class="absolute inset-0 flex flex-col items-center justify-center rounded-3xl border border-line bg-raised p-8 text-center shadow-[0_30px_60px_-30px_rgb(0_0_0/0.35)] [backface-visibility:hidden]">
            <p class="eyebrow">What does the bold word mean?</p>
            <p class="mt-6 font-serif text-4xl leading-tight sm:text-5xl">
              ¿Qué <span class="rounded-md bg-accent/30 px-1.5 text-umber">es</span> eso?
            </p>
            <span class="mt-8 inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.14em] text-muted uppercase">
              <span class="eq inline-flex h-4 items-end gap-[3px] text-moss" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
              Audio
            </span>
            <p class="absolute bottom-6 font-mono text-[10px] tracking-[0.16em] text-muted uppercase">Hover or tap to flip</p>
          </div>
          <div class="absolute inset-0 flex flex-col items-center justify-center rounded-3xl border border-moss bg-raised p-8 text-center [backface-visibility:hidden] [transform:rotateY(180deg)]">
            <p class="font-serif text-lg text-muted italic">What is that?</p>
            <p class="mt-4 font-serif text-5xl">ser</p>
            <p class="eyebrow mt-2">verb · es, soy, eres</p>
            <p class="mt-2 text-lg">to be</p>
            <div class="mt-6 w-full rounded-2xl bg-moss/10 p-4 text-left">
              <p class="eyebrow text-moss">Sounds like “SIR”</p>
              <p class="mt-1 text-sm leading-relaxed">A tiny knight called SIR stands on a pedestal shouting “I simply AM!” He just wants TO BE.</p>
            </div>
          </div>
        </div>
      </button>
      <p class="mt-4 text-center font-mono text-[11px] tracking-[0.1em] text-muted">One new word per card; every other word is already known.</p>
    </div>
  </div>
  <p class="mt-10 border-t border-line pt-5 font-mono text-[11px] leading-relaxed tracking-[0.1em] text-muted uppercase" data-reveal>
    Built with {p.stack.map((s, i) => <>{i > 0 && <span class="text-moss" aria-hidden="true"> · </span>}<span>{s}</span></>)}
  </p>
</article>

<style>
  .flip:hover .flip-inner,
  .flip:focus-visible .flip-inner,
  .flip[aria-pressed='true'] .flip-inner {
    transform: rotateY(180deg);
  }
  .flip:focus-visible {
    outline: 2px solid var(--moss);
    outline-offset: 6px;
    border-radius: 1.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .flip-inner { transition: none; }
  }
</style>

<script>
  // Tap to flip on touch screens (hover covers mouse users). Re-bound after each page transition.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-flip]').forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.setAttribute('aria-pressed', btn.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      });
    });
  });
</script>
