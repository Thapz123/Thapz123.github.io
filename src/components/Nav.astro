---
import { site } from '../data/site';

const links = [
  { href: '/', label: 'Home', desktopOnly: true }, // the T.S logo is the home link on small screens
  { href: '/work/', label: 'Work' },
  { href: '/studio/', label: 'Studio' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-bg/80 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6" aria-label="Primary">
    <a href="/" class="font-serif text-2xl leading-none tracking-tight">
      <span class="hidden sm:inline">{site.name}</span>
      <span class="sm:hidden" aria-label={site.name}>T<span class="text-moss">.</span>S</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-4">
      <ul class="flex items-center">
        {links.map((l) => {
          const active = path === l.href;
          return (
            <li class:list={[l.desktopOnly && 'max-sm:hidden']}>
              <a
                href={l.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'group relative flex items-center px-1.5 py-2 font-mono text-[10px] tracking-[0.12em] uppercase transition-colors sm:px-3 sm:text-[11px] sm:tracking-[0.16em]',
                  active ? 'text-fg' : 'text-muted hover:text-fg',
                ]}
              >
                {active && (
                  <span class="mr-1.5 text-moss" transition:name="nav-slash" aria-hidden="true">/</span>
                )}
                <span data-scramble>{l.label}</span>
              </a>
            </li>
          );
        })}
      </ul>
      <button
        type="button"
        data-theme-toggle
        class="grid size-9 shrink-0 place-items-center rounded-full border border-line text-muted transition-colors hover:border-fg hover:text-fg"
        aria-label="Toggle dark mode"
      >
        <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
        </svg>
        <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
    </div>
  </nav>
</header>
